# Salin berkas ini ke .env dan isi nilainya. .env TIDAK PERNAH masuk git.

# Database SIMRS Khanza — WAJIB pengguna read-only (lihat TECH_STACK.md)
SIK_DB_HOST=localhost
SIK_DB_PORT=3306
SIK_DB_NAME=sik
SIK_DB_USER=wakhanza_ro
SIK_DB_PASS=

# Database wakhanza
WA_DB_HOST=localhost
WA_DB_PORT=3306
WA_DB_NAME=wakhanza
WA_DB_USER=wakhanza_rw
WA_DB_PASS=

# WhatsApp
WA_SESSION_PATH=./.wwebjs_auth
WA_SEND_MIN_DELAY_MS=3000
WA_SEND_MAX_DELAY_MS=8000
WA_MAX_PER_HOUR=200

# Pemicu
POLL_INTERVAL_MS=60000
SCAN_INTERVAL_MS=300000
LOOKBACK_DAYS=30
QUERY_TIMEOUT_SEC=5
QUIET_HOURS_START=21
QUIET_HOURS_END=7
STALE_THRESHOLD_HOURS=6

# Dashboard
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://127.0.0.1:3100
SESSION_MAX_AGE_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
HOST=127.0.0.1
PORT=3100

# Log
LOG_LEVEL=info
LOG_DIR=./logs
