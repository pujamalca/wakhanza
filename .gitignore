# Rahasia — JANGAN pernah di-commit
.env
.env.local
.env.*.local
# Cadangan .env sebelum perubahan konfigurasi (mis. peralihan SIK_DB_NAME).
# Isinya kredensial yang sama persis dengan .env, jadi polanya harus ada di
# sini SEBELUM cadangan pertama dibuat -- bukan sesudahnya.
.env.bak
.env.bak-*
.env.backup*

# Sesi WhatsApp aktif. Berisi kredensial.
# WAJIB dicadangkan bersama database, TAPI di luar git.
.wwebjs_auth/
# Cadangan sesi saat penautan ulang -- isinya kredensial WhatsApp, sama sekali
# tidak boleh masuk repo. Pola di atas hanya cocok dengan namanya yang persis.
.wwebjs_auth.bak-*/
.wwebjs_cache/

# Cadangan terenkripsi (scripts/backup.ps1) -- berisi seluruh dump database
# dan sesi WhatsApp. Terenkripsi bukan alasan untuk taruh di git.
backups/

# Dependensi & hasil build
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# Runtime
logs/
*.log
npm-debug.log*
coverage/

# Lampiran broadcast yang diunggah staf. Sengaja DI LUAR public/ -- apa pun di
# bawah public/ dilayani Next.js tanpa autentikasi, jadi setiap surat edaran RS
# akan bisa diunduh siapa saja yang menebak namanya.
uploads/

# Skrip verifikasi sekali pakai. Ditaruh di dalam repo (bukan di direktori temp)
# semata supaya alias `@/` milik tsconfig berlaku; tidak pernah ikut di-commit.
.tmp-*.mts
.tmp-*.ts
.tmp-*.mjs
.tmp-*.md
.tmp-*.py

# OS
Thumbs.db
.DS_Store

# Keluaran `npm run dryrun:surat` -- berisi PDF surat pasien SUNGGUHAN, jadi
# tidak boleh ikut ter-commit (alasan yang sama dengan uploads/).
tmp-dryrun-surat/
tmp-dryrun-dokumen/

# Pagar terhadap `npx skills add`, yang bawaannya memasang ke DALAM proyek
# (`.agents/skills` + symlink `.claude/skills`) alih-alih ke `~/.claude` -- sakelar
# globalnya `-g`, dan gampang terlupa. Skill taste dipasang GLOBAL 18 Agustus 2026,
# jadi ketiga lintasan ini seharusnya kosong; kalau muncul lagi, itu pemasangan
# yang lupa `-g`. Ratusan KB prosa milik orang lain tidak boleh ikut ke repo publik.
.agents/
skills-lock.json

# `.claude/` TIDAK ditolak seluruhnya: skill milik PROYEK ini hidup di sana dan
# memang harus ikut repo -- ia berisi aturan kerja yang berlaku untuk siapa pun
# yang meng-clone. Yang ditolak adalah isi selebihnya, termasuk symlink yang
# ditanam `npx skills add`. Bentuknya bertingkat karena git TIDAK bisa
# mengembalikan sebuah berkas bila direktori induknya sudah ditolak, jadi
# `.claude/` harus dibuka dulu (`.claude/*`) sebelum isinya disaring.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/wakhanza/
