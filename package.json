{
  "name": "wakhanza",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway notifikasi WhatsApp untuk SIMRS Khanza",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3100",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker/index.ts",
    "worker:dev": "tsx watch src/worker/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "verify:db": "tsx scripts/verify-db.ts",
    "verify:plans": "tsx scripts/verify-plans.ts",
    "poll:dryrun": "tsx scripts/poll-dryrun.ts",
    "scan:contacts": "tsx scripts/scan-contacts.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "users": "tsx scripts/manage-users.ts",
    "harden:permissions": "powershell -ExecutionPolicy Bypass -File scripts/harden-permissions.ps1",
    "test": "jest",
    "test:int": "jest --config jest.integration.config.js",
    "audit": "npm audit --omit=dev",
    "dryrun:bpjs": "tsx scripts/dryrun-bpjs.ts",
    "dryrun:surat": "tsx scripts/dryrun-surat.ts",
    "dryrun:hibah": "tsx scripts/dryrun-hibah.ts",
    "dryrun:pemesanan": "tsx scripts/dryrun-pemesanan.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "bcrypt": "^6.0.0",
    "mysql2": "^3.23.2",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "node-cron": "^4.6.0",
    "pino": "^9.14.0",
    "pino-roll": "^2.2.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sequelize": "^6.37.8",
    "tsx": "^4.23.1",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.12",
    "typescript": "5.9.3"
  }
}
